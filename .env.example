# 复制为 .env 并填入真实值。所有 provider 目前假定走 OpenAI 兼容接口。

# LLM（Qwen/DeepSeek/GLM/Kimi 等任一家的 OpenAI 兼容 base_url）
CUSTOMER_RAG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CUSTOMER_RAG_LLM_API_KEY=
CUSTOMER_RAG_LLM_MODEL=qwen-max

# Embedding
CUSTOMER_RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CUSTOMER_RAG_EMBEDDING_API_KEY=
CUSTOMER_RAG_EMBEDDING_MODEL=text-embedding-v3
# 向量维度必须和上面 EMBEDDING_MODEL 实际输出的维度一致，否则建 collection 会失败。
# 具体数值请对照该模型的官方文档确认，这里的 1024 只是占位，不要直接当作确定值使用。
CUSTOMER_RAG_EMBEDDING_DIMENSION=1024
# 可选：部分供应商单次 embeddings 请求最多接受的文本条数有硬限制（实测阿里
# 百炼的 text-embedding 系列限20条/请求，超过直接400）。不设置则一次性发
# 全部文本，适合没有这类限制的供应商。
CUSTOMER_RAG_EMBEDDING_BATCH_SIZE=

# Milvus（docker-compose 里默认起在本机 19530）
CUSTOMER_RAG_MILVUS_URI=http://localhost:19530
CUSTOMER_RAG_MILVUS_COLLECTION=faq_chunks
# collection 不存在时用: python -m app.retrieval.collection_init
# 批量摄取文档（.md/.pdf/.docx/.png/.jpg/.jpeg/.csv 均支持）:
#   python -m app.ingestion.main --dir path/to/docs
# 注意：
# - PDF 表格密集页面会额外做 parent-child 分块（PyMuPDF 版面分析检测表格，
#   整表作为父级上下文、逐行拼成"表头：值"作为子级 embedding 目标），
#   见 app/ingestion/pdf_parser.py。
# - 图片格式 + "扫描件 PDF"（PDF 页面本身是图片、没有文字层）都走 OCR：
#   默认实现是 pytesseract（app/ingestion/ocr_parser.py），需要本机额外
#   安装 Tesseract OCR 引擎二进制（pip 装的 pytesseract 只是调用本机
#   tesseract 可执行文件的封装，不会自动装好引擎本身），中文识别还需装
#   chi_sim 语言包；也可以用 app/ingestion/dashscope_ocr.py 的百炼视觉OCR
#   模型替代，不需要装任何本地引擎，把 ocr=build_dashscope_ocr(...) 传给
#   ingest_pdf_file()/ingest_image_file() 即可，两者接口完全一致。
# - .csv 按历史工单导出格式解析（app/ingestion/ticket_parser.py），默认
#   列名 ticket_id/subject/description/resolution，只摄取已有处理方案的
#   工单；列名不一致的导出文件需要自定义 TicketColumnMapping 后调用
#   ingest_ticket_csv_file()，批量目录摄取只覆盖默认列名这一种情况。

# Rerank（可选：三项均留空则 /qa 跳过精排，仅走 RRF 融合排序）
# 接口形状是 {query, documents} -> {results:[{index, relevance_score}]}，
# 与 chat/embeddings 不同，不是 OpenAI 兼容接口，需要单独确认所选供应商的 rerank 端点。
CUSTOMER_RAG_RERANK_BASE_URL=
CUSTOMER_RAG_RERANK_API_KEY=
CUSTOMER_RAG_RERANK_MODEL=

# GraphRAG / Neo4j（docker-compose 里默认起在本机 7687，账号密码见 docker-compose.yml）
CUSTOMER_RAG_NEO4J_URI=bolt://localhost:7687
CUSTOMER_RAG_NEO4J_USER=neo4j
CUSTOMER_RAG_NEO4J_PASSWORD=changeme123
# !!! 默认指向占位示例数据 app/graphrag/terminology_seed.yaml，正式环境
# 必须替换为业务/技术支持团队协作产出的真实术语表文件路径，不能带着
# 占位示例数据上生产。
CUSTOMER_RAG_TERMINOLOGY_PATH=app/graphrag/terminology_seed.yaml
# 摄取时加 --build-graph 才会做 LLM 关系抽取+归一化+写入图谱:
# python -m app.ingestion.main --dir path/to/docs --build-graph

# Agent 推理：POST /agent/chat（SSE）。当前只在整个状态图跑完后发送一个
# 完整结果事件，不是逐 token 增量输出——真正的流式生成需要 provider 层
# 支持 streaming completion，目前尚未实现，见 app/api/agent_routes.py 注释。
#
# 可选：相关性阈值，检索到的记录即使非空，最高相关性分数（向量余弦相似度）
# 低于这个值也会转人工工单，而不是把不相关资料硬塞给LLM——真实向量库几乎
# 总能返回Top-K个最近邻，哪怕语义上完全不相关。默认不设置（对应完全空字符
# 串）=行为不变，只看结果是否为空。具体阈值需要结合实际embedding模型/语料
# 标定：本项目实测阿里百炼 qwen3.7-text-embedding 在真实文档上，相关结果
# 分数普遍在0.75+，明显不相关的问题分数在0.3左右，仅供参考起点，不是通用值。
CUSTOMER_RAG_AGENT_MIN_RELEVANCE_SCORE=
#
# LangSmith 类 tracing：LangGraph 检测到以下环境变量时会自动上报调用链路，
# 不需要在本项目里写任何自定义 tracing 代码。留空则不上报。
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=customer-rag

# 对话记忆（会话滑窗+摘要 / 长期记忆条目 / 异步consolidation队列 / 多源召回
# 融合+MMR / 时间指代解析+澄清状态机 / 主动性引擎），SQLite 文件路径，目录
# 不存在会自动创建。范围说明：时间/澄清状态机只在检索兜底路径生效（不做
# 全局拦截）；主动性引擎目前只有"工单挂起过久"一种真实触发检测（见
# app/memory/proactive_scan.py），"已知故障修复"/"客户说稍后再试"两种触发
# 只有文案模板、没有检测逻辑。
CUSTOMER_RAG_MEMORY_DB_PATH=data/memory.sqlite3

# 语音：ASR/TTS 均为可选项（不配置则对应功能不可用/自动跳过）。
# 接口形状均不是 OpenAI 兼容接口，需要单独确认所选供应商的端点。
#
# 范围说明（有意简化，非疏漏）：
# - WebSocket 流式ASR（/voice/asr/stream）已做分片去重合并+语气词过滤
#   （app/voice/asr_stream_processing.py）。
# - 文字请求（/agent/chat，voice_response=false）+语音请求（voice_response=
#   true）都已接入"LLM流式生成驱动逐句处理"：文字推 delta 文本事件，语音
#   推 audio 音频事件，每句都过一次分句轻量安全检查——是真正的"边生成边
#   处理"，不是"等完整回复生成完再处理"。provider 不支持 stream_complete()
#   时自动退化为原有的批量处理。
CUSTOMER_RAG_ASR_BASE_URL=
CUSTOMER_RAG_ASR_API_KEY=
CUSTOMER_RAG_ASR_MODEL=

CUSTOMER_RAG_TTS_BASE_URL=
CUSTOMER_RAG_TTS_API_KEY=
CUSTOMER_RAG_TTS_MODEL=
# 阿里百炼 CosyVoice 系列专用（三项都设置时优先于上面的 TTS_BASE_URL 通用
# provider）：CosyVoice 只支持 WebSocket 协议，走私有部署端点，且标准音色
# 名在私有部署上不可用，voice 必须是提前用 dashscope 的
# VoiceEnrollmentService 克隆好的 voice_id，见 app/providers/dashscope_tts.py。
CUSTOMER_RAG_TTS_DASHSCOPE_WEBSOCKET_URL=
CUSTOMER_RAG_TTS_DASHSCOPE_HTTP_URL=
CUSTOMER_RAG_TTS_DASHSCOPE_VOICE=
# 全量二次识别+专有名词校正: POST /voice/asr/finalize（multipart 文件上传）
# /agent/chat 请求体加 "voice_response": true 才会合成语音回复（按需触发）
