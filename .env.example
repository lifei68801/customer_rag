# 复制为 .env 并填入真实值。所有 provider 目前假定走 OpenAI 兼容接口。

# LLM（Qwen/DeepSeek/GLM/Kimi 等任一家的 OpenAI 兼容 base_url）
CUSTOMER_RAG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CUSTOMER_RAG_LLM_API_KEY=
CUSTOMER_RAG_LLM_MODEL=qwen-max

# Embedding
CUSTOMER_RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CUSTOMER_RAG_EMBEDDING_API_KEY=
CUSTOMER_RAG_EMBEDDING_MODEL=text-embedding-v3
# 向量维度必须和上面 EMBEDDING_MODEL 实际输出的维度一致，否则建 collection 会失败。
# 具体数值请对照该模型的官方文档确认，这里的 1024 只是占位，不要直接当作确定值使用。
CUSTOMER_RAG_EMBEDDING_DIMENSION=1024

# Milvus（docker-compose 里默认起在本机 19530）
CUSTOMER_RAG_MILVUS_URI=http://localhost:19530
CUSTOMER_RAG_MILVUS_COLLECTION=faq_chunks
# collection 不存在时用: python -m app.retrieval.collection_init
# 批量摄取文档（.md 和 .pdf 均支持）: python -m app.ingestion.main --dir path/to/docs
# 注意：PDF 目前只做逐页纯文本抽取（无 OCR），扫描件/图片型 PDF 无法提取文字。

# Rerank（可选：三项均留空则 /qa 跳过精排，仅走 RRF 融合排序）
# 接口形状是 {query, documents} -> {results:[{index, relevance_score}]}，
# 与 chat/embeddings 不同，不是 OpenAI 兼容接口，需要单独确认所选供应商的 rerank 端点。
CUSTOMER_RAG_RERANK_BASE_URL=
CUSTOMER_RAG_RERANK_API_KEY=
CUSTOMER_RAG_RERANK_MODEL=

# GraphRAG / Neo4j（docker-compose 里默认起在本机 7687，账号密码见 docker-compose.yml）
CUSTOMER_RAG_NEO4J_URI=bolt://localhost:7687
CUSTOMER_RAG_NEO4J_USER=neo4j
CUSTOMER_RAG_NEO4J_PASSWORD=changeme123
# !!! 默认指向占位示例数据 app/graphrag/terminology_seed.yaml，正式环境
# 必须替换为业务/技术支持团队协作产出的真实术语表文件路径，不能带着
# 占位示例数据上生产。
CUSTOMER_RAG_TERMINOLOGY_PATH=app/graphrag/terminology_seed.yaml
# 摄取时加 --build-graph 才会做 LLM 关系抽取+归一化+写入图谱:
# python -m app.ingestion.main --dir path/to/docs --build-graph

# Agent 推理：POST /agent/chat（SSE）。当前只在整个状态图跑完后发送一个
# 完整结果事件，不是逐 token 增量输出——真正的流式生成需要 provider 层
# 支持 streaming completion，目前尚未实现，见 app/api/agent_routes.py 注释。
#
# LangSmith 类 tracing：LangGraph 检测到以下环境变量时会自动上报调用链路，
# 不需要在本项目里写任何自定义 tracing 代码。留空则不上报。
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=customer-rag
