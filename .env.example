# 复制为 .env 并填入真实值。所有 provider 目前假定走 OpenAI 兼容接口。

# LLM（Qwen/DeepSeek/GLM/Kimi 等任一家的 OpenAI 兼容 base_url）
CUSTOMER_RAG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CUSTOMER_RAG_LLM_API_KEY=
CUSTOMER_RAG_LLM_MODEL=qwen-max

# Embedding
CUSTOMER_RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CUSTOMER_RAG_EMBEDDING_API_KEY=
CUSTOMER_RAG_EMBEDDING_MODEL=text-embedding-v3
